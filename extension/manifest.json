{
    "manifest_version": 3,
    "name": "Freelancer Protection Radar (LAYA)",
    "version": "1.0",
    "description": "Real-time client red-flag and nightmare scanner for Upwork using local LAYA AI.",
    "permissions": [
        "activeTab"
    ],
    "host_permissions": [
        "https://*.upwork.com/*",
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*",
        "https://*.trycloudflare.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.upwork.com/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "styles.css"
            ],
            "run_at": "document_idle"
        }
    ]
}